{
  "expo": {
    "name": "ExpertListingMobile",
    "slug": "ExpertListingMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expertListingIcon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.akinmiday.ExpertListingMobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71754028-9420-4607-910a-e5e1eb48b187"
      }
    }
  }
}
